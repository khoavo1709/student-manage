generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id                Int             @id @default(autoincrement())
  fullName          String
  dateOfBirth       DateTime
  gender            String
  address           String?
  guardianName      String?
  guardianPhone     String?
  guardianRelation  String?         // "Bo" | "Me" | "Nguoi giam ho" | ...
  classes           StudentClass[]
  scores            Score[]
  tuitions          Tuition[]
  createdAt         DateTime        @default(now())
}

model Class {
  id          Int             @id @default(autoincrement())
  name        String          // VD: "Toan lop 3", "Ly lop 7" (mon hoc + khoi gop trong ten)
  tuitionFee  Float           // hoc phi co dinh theo thang cho lop nay
  students    StudentClass[]
  scores      Score[]
  tuitions    Tuition[]
  schedules   Schedule[]
  createdAt   DateTime        @default(now())
}

// Bang trung gian: 1 hoc sinh co the hoc nhieu lop, 1 lop co nhieu hoc sinh.
model StudentClass {
  studentId Int
  student   Student @relation(fields: [studentId], references: [id])
  classId   Int
  class     Class   @relation(fields: [classId], references: [id])

  @@id([studentId, classId])
}

model Score {
  id        Int      @id @default(autoincrement())
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id])
  classId   Int      // bai kiem tra thuoc lop nao (hoc sinh co the hoc nhieu lop)
  class     Class    @relation(fields: [classId], references: [id])
  examName  String   // VD: "Dot 1", "Dot 2", "Kiem tra giua ky"
  value     Float
  date      DateTime
  note      String?
}

model Tuition {
  id        Int       @id @default(autoincrement())
  studentId Int
  student   Student   @relation(fields: [studentId], references: [id])
  classId   Int       // hoc sinh hoc nhieu lop se co nhieu khoan phi/thang, moi khoan gan voi 1 lop
  class     Class     @relation(fields: [classId], references: [id])
  year      Int
  month     Int       // 1-12
  status    String    // "da dong" | "chua dong"
  paidDate  DateTime?

  @@unique([studentId, classId, year, month])
}

model Schedule {
  id        Int      @id @default(autoincrement())
  classId   Int
  class     Class    @relation(fields: [classId], references: [id])
  dayOfWeek Int      // 0=CN, 1=Thu2, ... 6=Thu7
  startTime String   // "07:30"
  endTime   String   // "09:00"
  startDate DateTime // ngay bat dau ap dung lich nay
  endDate   DateTime // ngay ket thuc ap dung lich nay
}

model Admin {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String // hashed (bcrypt)
}
